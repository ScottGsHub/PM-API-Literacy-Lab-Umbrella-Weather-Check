      "id": "ba23e57a-631d-4266-a757-cb2dc4622155",
      "name": "HTTP — Get Forecast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2352,
        912
      ],
      "notesInFlow": true,
      "onError": "continueErrorOutput",
      "notes": "Second real API call. Its latitude/longitude inputs came from the first API. The requested fields intentionally match the Postman article."
    },
    {
      "parameters": {
        "jsCode": "const forecast = $input.first().json;\nconst location = $('Extract Coordinates + Location Context').first().json;\n\nconst daily = forecast.daily || {};\nconst current = forecast.current || {};\nconst currentUnits = forecast.current_units || {};\nconst dailyUnits = forecast.daily_units || {};\n\nconst index = 1; // Open-Meteo daily arrays: 0=today, 1=tomorrow.\nconst tomorrowDate = daily.time?.[index] ?? null;\nconst precipitationProbability = daily.precipitation_probability_max?.[index] ?? null;\nconst tempMax = daily.temperature_2m_max?.[index] ?? null;\nconst tempMin = daily.temperature_2m_min?.[index] ?? null;\n\nconst forecastOk =\n  tomorrowDate !== null &&\n  precipitationProbability !== null &&\n  precipitationProbability !== undefined;\n\nreturn [{\n  json: {\n    input_source: location.input_source,\n    city_requested: location.city,\n    resolved_location: [location.resolved_name, location.admin1, location.country]\n      .filter(Boolean)\n      .join(', '),\n    latitude: location.latitude,\n    longitude: location.longitude,\n    timezone: forecast.timezone || location.timezone || null,\n\n    current_temperature: current.temperature_2m ?? null,\n    current_temperature_unit: currentUnits.temperature_2m ?? null,\n    current_apparent_temperature: current.apparent_temperature ?? null,\n    current_apparent_temperature_unit: currentUnits.apparent_temperature ?? null,\n    current_precipitation: current.precipitation ?? null,\n    current_precipitation_unit: currentUnits.precipitation ?? null,\n\n    tomorrow_date: tomorrowDate,\n    tomorrow_temperature_max: tempMax,\n    tomorrow_temperature_max_unit: dailyUnits.temperature_2m_max ?? null,\n    tomorrow_temperature_min: tempMin,\n    tomorrow_temperature_min_unit: dailyUnits.temperature_2m_min ?? null,\n    tomorrow_precipitation_probability_max: precipitationProbability,\n    tomorrow_precipitation_probability_unit: dailyUnits.precipitation_probability_max ?? '%',\n\n    forecast_ok: forecastOk\n  }\n}];"
